# Email Configuration for INVESTIGATE.AGENT
# Copy this file to .env and fill in your email credentials

# Gmail SMTP Settings
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Server Port (optional)
PORT=3001

# Database Configuration (PostgreSQL or SQLite fallback)
# Leave these blank to automatically fall back and use the default SQLite database file (investigate-agent.db).
# To use PostgreSQL, uncomment and fill in one of the configurations below:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/investigate_agent

# OR fill in individual variables:
# PGHOST=localhost
# PGUSER=postgres
# PGPASSWORD=your-password
# PGDATABASE=investigate_agent
# PGPORT=5432

# Instructions to get Gmail App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already enabled
# 3. Go to App passwords
# 4. Select Mail and Windows Computer
# 5. Copy the generated 16-character password
# 6. Paste it in EMAIL_PASS above (remove spaces if any)

# Alternative: Use environment variables
# export EMAIL_USER="your-email@gmail.com"
# export EMAIL_PASS="your-app-password"
# Then run: npm install && node server.js
